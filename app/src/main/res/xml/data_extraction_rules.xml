<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup from Android 12 on; same rule as backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="web_access.xml" />
        <exclude domain="file" path="datastore/lifeorganizer_secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="web_access.xml" />
        <exclude domain="file" path="datastore/lifeorganizer_secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
