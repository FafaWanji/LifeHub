<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup up to Android 11. Everything is backed up except the PC-access pairings (browsers paired with
     the old phone must not get access to a restored one) and the API key. -->
<full-backup-content>
    <exclude domain="sharedpref" path="web_access.xml" />
    <exclude domain="file" path="datastore/lifeorganizer_secrets.preferences_pb" />
</full-backup-content>
